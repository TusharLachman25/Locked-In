# Copy to .env and fill in. .env is gitignored.
#
# EXPO_PUBLIC_ variables are inlined into the client bundle at build time, on
# native and on web — none of these is a secret in the sense of being hidden
# from a user holding the APK. The anon key is safe to ship precisely because
# row-level security, not the key, is what protects the data.
#
# For EAS builds and the Vercel web deploy these live in the respective
# project's environment variables instead; this file only covers `expo start`.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=
